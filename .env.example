# PostgreSQL (Supabase), same setup as Digital Workspace.
# Pooled connection (pgBouncer, port 6543) used by the app:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma for schema changes:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Secret for signing session cookies (phase 2: accounts). Generate with: openssl rand -base64 32
AUTH_SECRET=""
