// Qalam Academy — data model.
//
// Runs on PostgreSQL (Supabase), like Digital Workspace. DATABASE_URL is the
// pooled connection used by the app; DIRECT_URL is the direct connection
// Prisma uses for schema changes.
//
// Phase 1 keeps progress in the browser (guest mode). These tables are ready
// for phase 2: accounts, family circles, and progress synced across devices.
//
// Points are a ledger (PointEvent) so totals can be audited and never drift.
// Worship is never scored: there is deliberately no table for "prayers done".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String?  @unique
  name               String
  passwordHash       String?
  // "ADULT" | "CHILD". Children are created by a parent inside a family and
  // sign in with a family code, not an email.
  kind               String   @default("ADULT")
  themePreference    String   @default("system") // "light" | "dark" | "system"
  languagePreference String   @default("uz") // "uz" | "ru" | "en"
  // Which guidance notes the prayer guide shows by default: "m" | "w".
  guideGender        String   @default("m")
  cityKey            String   @default("tashkent")
  calcMethod         String   @default("MWL")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions    Session[]
  memberships FamilyMember[]
  answers     QuestionAnswer[]
  topics      TopicProgress[]
  guides      GuideStudied[]
  points      PointEvent[]
  hifz        HifzProgress[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// A private family circle: parents see their children's learning progress.
// No public leaderboards.
model Family {
  id        String         @id @default(cuid())
  name      String
  joinCode  String         @unique
  createdAt DateTime       @default(now())
  members   FamilyMember[]
}

model FamilyMember {
  id       String @id @default(cuid())
  familyId String
  userId   String
  role     String @default("CHILD") // "PARENT" | "CHILD"
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

// One row per question a user has ever answered correctly (first-time points).
model QuestionAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String // e.g. "salah-3"
  firstAt    DateTime @default(now())
  repeats    Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model TopicProgress {
  id        String    @id @default(cuid())
  userId    String
  topicId   String
  perfectAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model GuideStudied {
  id      String   @id @default(cuid())
  userId  String
  guideId String // "wudu" | "fajr-0" | ...
  at      DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guideId])
}

model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // "answer" | "repeat" | "perfect" | "guide"
  ref       String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Memorisation progress per surah or passage, with spaced-repetition review.
model HifzProgress {
  id          String    @id @default(cuid())
  userId      String
  itemId      String // "112", "ayat-al-kursi", "kahf-1-10"
  status      String    @default("learning") // "learning" | "memorized"
  knownAyahs  Int[]
  memorizedAt DateTime?
  interval    Int       @default(0)
  nextReview  DateTime?
  reviews     Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, nextReview])
}
